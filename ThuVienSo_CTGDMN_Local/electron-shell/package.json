{
  "name": "ctgdmn-local-desktop",
  "version": "1.0.7",
  "description": "Desktop launcher for Thu vien so CTGDMN Local App",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "vn.ctgdmn.thuvienso.local",
    "productName": "Thu vien so CTGDMN",
    "publish": null,
    "directories": {
      "output": "../../dist-installer"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      { "from": "../resources/backend", "to": "backend", "filter": ["**/*", "!__pycache__"] },
      { "from": "../resources/frontend", "to": "frontend" },
      { "from": "../resources/data", "to": "data" },
      { "from": "../resources/requirements.txt", "to": "requirements.txt" },
      { "from": "../resources/run_backend.bat", "to": "run_backend.bat" }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "../resources/frontend/assets/logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
